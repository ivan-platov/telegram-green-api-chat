{
  "name": "telegram-green-api-chat",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "test:e2e": "tsc -p tsconfig.e2e.json && playwright test",
    "test:e2e:production": "tsc -p tsconfig.e2e.json && playwright test --config playwright.production.config.ts",
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix --max-warnings 0",
    "check": "npm run lint && npm run format:check && npm test && npm run build",
    "fix": "npm run lint:fix && npm run format"
  },
  "dependencies": {
    "@tanstack/react-virtual": "3.14.21",
    "axios": "1.20.0",
    "libphonenumber-js": "1.13.15",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@eslint-react/eslint-plugin": "5.28.4",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@stylistic/eslint-plugin": "5.10.0",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "eslint": "10.13.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-import-resolver-typescript": "4.4.5",
    "eslint-plugin-import-x": "4.17.1",
    "eslint-plugin-jsx-a11y-x": "0.2.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "prettier": "3.9.10",
    "prettier-plugin-tailwindcss": "0.8.1",
    "sass": "1.106.1",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "vite": "8.3.4"
  }
}
